<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bertrand Gonthier – Consultant IA & Data Science</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0f1117;
            --bg-card: #1a1d27;
            --bg-card-hover: #22263a;
            --surface: #252a3a;
            --accent: #6c9cfc;
            --accent-dim: #4a7df7;
            --accent-glow: rgba(108,156,252,0.15);
            --text: #e4e7f1;
            --text-muted: #8b90a5;
            --text-dim: #5c6178;
            --border: #2a2f42;
            --success: #6ee7b7;
            --white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Hero ── */
        .hero {
            position: relative;
            padding: 70px 40px 50px;
            background: linear-gradient(160deg, #0f1117 0%, #161b2e 40%, #1c2240 100%);
            border-bottom: 1px solid var(--border);
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -120px; right: -120px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(108,156,252,0.08) 0%, transparent 70%);
            pointer-events: none;
        }

        .hero-inner {
            max-width: 1000px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .avatar {
            width: 140px; height: 140px;
            border-radius: 50%;
            border: 3px solid var(--accent);
            box-shadow: 0 0 30px rgba(108,156,252,0.2);
            object-fit: cover;
            flex-shrink: 0;
        }

        .hero-text { flex: 1; }

        .hero-text h1 {
            font-size: 2.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
            color: var(--white);
        }

        .hero-text .tagline {
            font-size: 1.05rem;
            color: var(--accent);
            font-weight: 500;
            margin-bottom: 6px;
        }

        .hero-text .location {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--accent-glow);
            border: 1px solid rgba(108,156,252,0.25);
            border-radius: 24px;
            padding: 8px 20px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--accent);
        }

        .btn-linkedin {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #0a66c2;
            color: var(--white);
            text-decoration: none;
            padding: 9px 22px;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 600;
            transition: background 0.2s, transform 0.15s;
        }

        .btn-linkedin:hover {
            background: #004182;
            transform: translateY(-1px);
        }

        .btn-linkedin svg {
            width: 18px; height: 18px;
            fill: currentColor;
        }

        /* ── Container ── */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 50px 20px;
        }

        section { margin-bottom: 56px; }

        h2 {
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-muted);
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        h2::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ── Narrative ── */
        .narrative {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 56px;
            position: relative;
            overflow: hidden;
        }

        .narrative::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-dim), var(--accent), var(--accent-dim));
        }

        .narrative h2 {
            border: none;
            justify-content: center;
            font-size: 1.05rem;
            letter-spacing: 1.5px;
            margin-bottom: 24px;
            color: var(--text);
        }

        .narrative h2::after { display: none; }

        .narrative p {
            font-size: 0.98rem;
            color: var(--text-muted);
            text-align: center;
            max-width: 780px;
            margin: 0 auto 14px;
        }

        .narrative .hl {
            color: var(--accent);
            font-weight: 600;
        }

        /* ── Timeline ── */
        .timeline {
            position: relative;
            padding-left: 32px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 7px; top: 0; bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .tl-item {
            position: relative;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 26px 28px;
            margin-bottom: 18px;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        .tl-item:hover {
            border-color: rgba(108,156,252,0.3);
            box-shadow: 0 0 24px rgba(108,156,252,0.06);
        }

        .tl-item::before {
            content: '';
            position: absolute;
            left: -29px; top: 32px;
            width: 12px; height: 12px;
            background: var(--accent);
            border: 3px solid var(--bg);
            border-radius: 50%;
        }

        .tl-date {
            display: inline-block;
            background: var(--surface);
            color: var(--accent);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 12px;
            border-radius: 6px;
            margin-bottom: 10px;
            letter-spacing: 0.3px;
        }

        .tl-item h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 2px;
        }

        .tl-company {
            color: var(--text-muted);
            font-size: 0.88rem;
            margin-bottom: 12px;
        }

        .tl-item ul { list-style: none; }

        .tl-item li {
            padding: 3px 0 3px 16px;
            position: relative;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .tl-item li::before {
            content: '›';
            position: absolute;
            left: 0;
            color: var(--accent);
            font-weight: 700;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 14px;
        }

        .tag {
            background: var(--surface);
            color: var(--accent);
            font-size: 0.72rem;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 6px;
            letter-spacing: 0.3px;
        }

        /* ── Formation ── */
        .edu-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px 28px;
            margin-bottom: 14px;
        }

        .edu-card h3 {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 2px;
        }

        .edu-card .school {
            color: var(--accent);
            font-size: 0.88rem;
            font-weight: 500;
        }

        .edu-card .date {
            color: var(--text-dim);
            font-size: 0.82rem;
            margin-bottom: 8px;
        }

        .edu-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* ── Certifications ── */
        .cert-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 14px;
        }

        .cert-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px 24px;
            transition: border-color 0.2s;
        }

        .cert-card:hover {
            border-color: rgba(108,156,252,0.3);
        }

        .cert-card .cat {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--accent);
            margin-bottom: 6px;
        }

        .cert-card h4 {
            color: var(--white);
            font-size: 0.92rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .cert-card .src {
            color: var(--text-dim);
            font-size: 0.8rem;
        }

        /* ── Skills ── */
        .skills-section h3 {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .skill-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 28px;
        }

        .skill-chip {
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 8px 18px;
            border-radius: 8px;
            transition: border-color 0.2s, background 0.2s;
        }

        .skill-chip:hover {
            border-color: var(--accent);
            background: var(--accent-glow);
        }

        /* ── Footer ── */
        footer {
            border-top: 1px solid var(--border);
            text-align: center;
            padding: 28px;
            color: var(--text-dim);
            font-size: 0.82rem;
        }

        /* ── Responsive ── */
        @media (max-width: 640px) {
            .hero { padding: 40px 20px 36px; }
            .hero-inner {
                flex-direction: column;
                text-align: center;
            }
            .avatar { width: 110px; height: 110px; }
            .hero-text h1 { font-size: 1.8rem; }
            .hero-actions { justify-content: center; }
            .container { padding: 30px 16px; }
            .timeline { padding-left: 26px; }
            .tl-item::before { left: -23px; }
            .narrative { padding: 28px 20px; }
            .narrative p { text-align: left; }
        }
    </style>
</head>
